{
  "name": "dsh-content-studio",
  "version": "0.4.2",
  "description": "DSH bundle plugin: 内容创作与多平台分发 —— 桌面截屏/录屏、Markdown→小红书图文卡片（5 配色 × 4 版式、照片插图、背景图）、dev.to 官方 API 发布、发布前人工审阅（草稿落盘），并挂载 Playwright 与小红书 MCP。",
  "type": "module",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.cjs"
  },
  "files": [
    "src/",
    "vendor/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "preset.yml",
    "agent.cordis.yml",
    "plugins/",
    "skills/",
    "lib/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "xiaohongshu",
    "content",
    "screenshot",
    "screen-recording",
    "devto"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ZRui-C/dsh-content-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZRui-C/dsh-content-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ZRui-C/dsh-content-studio/issues"
  }
}
